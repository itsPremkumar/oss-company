# delegated-git.env — Credential passthrough manifest for non-interactive delegates
#
# This is a TEMPLATE. Real tokens are NEVER committed here.
# The backend/delegate runtime injects the actual GITHUB_TOKEN at spawn time.
#
# Author: @devops-engineer (per CTO directive subagent-cred-debug.md)
# Status: v1.0 — verified working in this environment (schannel OS credential cache)
#
# === How it works ===
# Interactive avatars authenticate via `gh auth login` → token stored in
# Windows Credential Manager (schannel SSL backend). Non-interactive delegated
# subagents (delegate_task / cronjob no_agent) run in a fresh process context.
#
# === Credential resolution order (tested) ===
# 1. GITHUB_TOKEN env var (highest priority) — injected by delegate runtime
# 2. GH_TOKEN env var — fallback
# 3. gh keyring via `gh.exe auth git-credential` — works IF HOME is inherited
# 4. Windows Credential Manager via schannel — works IF OS-level access is shared
#
# === Verification ===
# In this environment, `git ls-remote https://github.com/itsPremkumar/oss-company HEAD`
# succeeds from a delegated subagent (cronjob no_agent=True) because:
#   - HOME is inherited (/c/Users/PREM KUMAR)
#   - gh keyring is accessible at OS level
#   - schannel backend resolves cached Windows credentials
#
# If ls-remote fails in a different backend, set one of the explicit paths below.
#
# === Fix options (set ONE) ===
#
# Option A: GITHUB_TOKEN injection (preferred)
#   The delegate runtime sets:
#     GITHUB_TOKEN=<gho_xxx> (PAT with repo + read:packages scope)
#   Git uses this automatically for HTTPS GitHub URLs.
#
# Option B: GIT_ASKPASS manifest
#   GIT_ASKPASS=C:\Users\PREM KUMAR\AppData\Local\hermes\profiles\devops-engineer\scripts\git-askpass.sh
#   (script emits the token to stdout when called by git credential callback)
#
# Option C: .netrc file (least secure — do not commit actual credentials)
#   ~/.netrc:
#     machine github.com
#     login <username>
#     password <gho_xxx>
#
# === Current environment values (from main-profile diagnostic) ===
# git config --global credential.https://github.com.helper = !"C:\Program Files\GitHub CLI\gh.exe" auth git-credential
# git config --system http.sslBackend = schannel
# GH_TOKEN: (not set — keyring used instead)
# GITHUB_TOKEN: (not set — keyring used instead)

[credential "https://github.com"]
    helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential

[credential "https://github.com"]
    username = itsPremkumar
